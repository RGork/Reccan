# PostHog dashboard configuratie
dashboard.reccan.nl {
    encode gzip zstd
    
    # Handle oude PostHog endpoint voor backward compatibility
    @posthog_old_endpoint path /i/v0/e/*
    uri strip_prefix /i/v0/e
    rewrite @posthog_old_endpoint /capture
    
    # Reverse proxy naar PostHog services
    reverse_proxy http://web:8000
    reverse_proxy http://livestream:8666
}

# Bestaande configuratie (zonder auto_https off als je HTTPS wilt)
{
	# auto_https off - verwijder deze regel als je HTTPS wilt gebruiken
}

:8081 {
    route /echo {
        respond `{http.request.body}` 200 {
            close
        }
    }
    
    route /fail {
        respond `{http.request.body}` 400 {
            close
        }
    }
}
